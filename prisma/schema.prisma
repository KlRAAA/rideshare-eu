generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  FACULTY
  STAFF
}

enum GenderPreference {
  ANY
  WOMEN_PLUS
}

enum RecurrenceType {
  ONE_TIME
  DAILY
  WEEKDAYS
  CUSTOM
}

enum TripStatus {
  OPEN
  FULL
  CANCELLED
  COMPLETED
}

enum MatchStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
  COMPLETED
}

enum NotificationType {
  MATCH_REQUEST
  APPROVAL
  REMINDER
  RATING_PROMPT
  CANCELLATION
  TRIP_UPDATED
  MESSAGE
  SUPPORT_REPLY
  ANNOUNCEMENT
  WARNING
  TRIP_STARTED
  CONFIRM_REQUEST
  DRIVER_UNCONFIRMED
  DRIVER_LATE
  DRIVER_NO_SHOW
  TRIP_SKIPPED
  LICENSE_APPROVED
  LICENSE_REJECTED
  LICENSE_REQUIRED
  LICENSE_EXPIRING
  DRIVER_ARRIVING
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

// Pump grades at Philippine stations: Unleaded 91, Premium 95, Diesel. Each
// has its own official price, and each car records which one it uses.
enum FuelType {
  REGULAR
  PREMIUM
  DIESEL
}

enum AdminActionType {
  BAN
  UNBAN
  REPORT_REVIEWED
  REPORT_DISMISSED
  TRIP_CANCELLED
  FUEL_PRICE_SET
  PROMOTE
  DEMOTE
  SUPPORT_REPLIED
  SUPPORT_CLOSED
  ANNOUNCEMENT_POSTED
  DATA_RELEASED
  DATA_RELEASE_VIEWED
  DATA_PAPERWORK_RECEIVED
  SUPERADMIN_SET
  WARNING_ISSUED
  LICENSE_APPROVED
  LICENSE_REJECTED
}

enum WarningReason {
  SMOKING
  UNSAFE_DRIVING
  LATE_OR_NO_SHOW
  DISRESPECTFUL
  OTHER
}

// An official warning from an admin: the step before a suspension. The warned
// user sees a notification, an email and a dashboard banner until they
// acknowledge it. Never names the reporter. Ids are plain, like AdminAction's,
// so the record survives account deletion.
model UserWarning {
  id             String        @id @default(cuid())
  userId         String
  issuedById     String
  reason         WarningReason
  note           String?
  reportId       String?
  ticketId       String?
  tripId         String?
  createdAt      DateTime      @default(now())
  acknowledgedAt DateTime?

  @@index([userId, createdAt])
}

enum DataRequestBasis {
  WARRANT
  COURT_ORDER
  SUBPOENA
  EMERGENCY
}

// A request from the police or another authority for one person's records.
// Holds who asked and why, never the released data (that is rebuilt when
// opened, so no second copy of personal data is kept). Ids are plain, like
// AdminAction's targets, so the record survives account deletion.
model DataRequest {
  id                  String           @id @default(cuid())
  createdById         String
  subjectUserId       String
  agency              String
  officerName         String
  officerContact      String
  referenceNumber     String
  legalBasis          DataRequestBasis
  fromDate            DateTime?
  toDate              DateTime?
  includeChats        Boolean          @default(false)
  includeSupport      Boolean          @default(false)
  verificationNote    String
  paperworkDueAt      DateTime?
  paperworkReceivedAt DateTime?
  createdAt           DateTime         @default(now())

  @@index([createdAt])
}

// Help & support: a user's request to the admins, and the replies on it.
enum SupportCategory {
  APP_PROBLEM
  ACCOUNT
  SAFETY
  FUEL_SHARE
  OTHER
}

enum SupportStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum ReportCategory {
  SPAM
  NO_SHOW
  INAPPROPRIATE_BEHAVIOR
  HARASSMENT
  SAFETY
  OTHER
}

model User {
  id           String   @id @default(cuid())
  universityId String   @unique // self-reported (e.g. "2023-12345"); no live ICTD record to verify it against
  email        String   @unique
  passwordHash String   // bcrypt — there is no ICTD/Workspace SSO to hand off to
  // fullName and gender are AES-256-GCM ciphertext at rest (iv:authTag:data,
  // base64 — server/services/encryptionService.js), encrypted/decrypted in
  // application code, never filtered or sorted on at the DB level. gender is
  // self-declared: WOMAN / MAN / NON_BINARY / PREFER_NOT_TO_SAY (the safe
  // default). It only decides Women+ eligibility (server/services/riderRules.js)
  // and is never shown to other users.
  fullName     String
  role         Role
  gender       String   // Women+ eligibility only — see riderRules.js
  verified     Boolean  @default(false) // true once registration's OTP + domain whitelist checks pass
  avatarUrl    String?  // /uploads/avatars/<uuid>.<ext>, served from Next's public/; null = show initials
  trustScore   Float    @default(5.0)
  tripCount    Int      @default(0)
  createdAt    DateTime @default(now())
  // Terms-of-use / privacy-policy consent, captured at registration
  // (authController.completeRegistration) — both null for any account that
  // predates this column. termsVersion records WHICH version was agreed to,
  // since re-prompting on a future terms change means comparing against a
  // stored version, not just checking "is this non-null".
  termsAcceptedAt DateTime?
  termsVersion    String?
  // Moderation state — set by the strike ladder in
  // reportEnforcementService.js or by an admin (/api/admin/users/:id/ban);
  // every change is recorded in AdminAction. A far-future bannedUntil (year 9999)
  // IS how "permanent" is represented — no separate boolean — so the
  // authenticate middleware's ban check stays one timestamp comparison
  // instead of needing a second branch. banReason stores the ReportCategory
  // that triggered this specific ban action.
  bannedUntil DateTime?
  banReason   String?
  banSeverity String? // "STANDARD" | "HIGH_ALERT"
  // Flips true the first time this user finishes or skips the onboarding
  // tour (PATCH /api/users/me/onboarding) — either one means "don't auto-show
  // again," not just a completed run. "Show tutorial again" replays the tour
  // client-side without touching this column.
  hasSeenOnboarding Boolean @default(false)
  // Read by the authenticate middleware on every request, so a demotion
  // takes effect immediately. Granted by `npm run make-admin` or another admin.
  isAdmin Boolean @default(false)
  // The one superadmin (the school's Data Protection Officer): manages admins
  // and alone releases records for a data request. Set only by
  // `npm run make-superadmin`; read by authenticate on every request.
  isSuperAdmin Boolean @default(false)
  // Set when the user deletes their account (accountDeletionService). The row
  // stays, anonymized, so other people's trip history, ratings and safety
  // reports still resolve; authenticate refuses any session for it.
  deletedAt DateTime?

  vehicles        Vehicle[]
  savedVehicles   SavedVehicle[]
  licenses        DriverLicense[]
  pushSubscriptions PushSubscription[]
  hostedTrips     Trip[]          @relation("HostTrips")
  matches         Match[]         @relation("PassengerMatches")
  notifications   Notification[]
  preference      Preference?
  ratingsGiven    Rating[]        @relation("RaterRatings")
  ratingsReceived Rating[]        @relation("RateeRatings")
  messagesSent    Message[]
  reportsFiled    Report[]        @relation("ReportsFiled")
  reportsReceived Report[]        @relation("ReportsReceived")
  reportsReviewed Report[]        @relation("ReportsReviewed")
  fuelPricesSet   FuelPrice[]
  adminActions    AdminAction[]   @relation("AdminActionActor")
  supportTickets  SupportTicket[]  @relation("SupportTickets")
  supportMessages SupportMessage[] @relation("SupportMessages")
  announcements   Announcement[]   @relation("Announcements")
  activeMode      AppMode          @default(PASSENGER) // Driver or Passenger mode (sub-project C)
}

model Vehicle {
  id                String  @id @default(cuid())
  ownerId           String
  owner             User    @relation(fields: [ownerId], references: [id])
  make              String
  model             String
  color             String
  plate             String?
  fuelEfficiencyKmL Float
  fuelType          FuelType @default(REGULAR)
  trips             Trip[]

  @@index([ownerId])
}

// A host's "My cars" list. Only fills in the post-trip form: each trip still
// gets its own Vehicle row (a snapshot), so editing one trip's car never
// changes another trip or the saved car.
model SavedVehicle {
  id                String   @id @default(cuid())
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id])
  make              String
  model             String
  color             String
  plate             String?
  fuelEfficiencyKmL Float
  fuelType          FuelType @default(REGULAR)
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([ownerId])
}

model Trip {
  id                  String           @id @default(cuid())
  hostId              String
  host                User             @relation("HostTrips", fields: [hostId], references: [id])
  vehicleId           String
  vehicle             Vehicle          @relation(fields: [vehicleId], references: [id])
  // originAddress/destinationAddress/meetingPointAddress are AES-256-GCM
  // ciphertext at rest (same scheme as User.fullName/gender) — the
  // human-readable text is what reveals a home/work location by name, unlike
  // the bare lat/lng pair; those stay plaintext since the PSGA does real
  // arithmetic on them (haversine, route-overlap sampling) that ciphertext
  // can't support without decrypting on every single computation.
  originAddress       String
  originLat           Float
  originLng           Float
  destinationAddress  String
  destinationLat      Float
  destinationLng      Float
  routeWaypoints      Json?            // [{lat,lng}, ...] road geometry from the Mapbox Directions call at creation; null if it failed the sanity check
  distanceMeters      Int?             // road distance from the same Directions call; feeds nothing yet but persisted alongside durationSeconds so both survive
  departureTime       DateTime
  recurrenceType      RecurrenceType
  customDays          Int[]            @default([]) // 0=Sun..6=Sat, used when CUSTOM
  totalSeats          Int
  filledSeats         Int              @default(0)
  fuelShareSuggested  Float?           // DEPRECATED — old host-typed guess, no longer read or written; superseded by fuelSharePerSeat. Kept only to avoid a destructive column drop; safe to remove in a later migration.
  fuelPricePerLiter   Float?           // host-entered retail price (PHP/L) at posting time — no reliable free PH fuel-price API exists, so the host supplies today's price instead of a stale hardcoded default. Frozen alongside fuelSharePerSeat once computed.
  fuelSharePerSeat    Float?           // fixed voluntary contribution per passenger seat, computed once at posting from distance / vehicle efficiency / fuelPricePerLiter ÷ totalSeats (driver excluded); null if distance or price was unavailable
  driverNotes         String?
  genderPreference    GenderPreference @default(ANY)
  flexibleDeparture   Boolean          @default(false)
  flexWindowMinutes   Int              @default(15)
  familiarRidersOnly  Boolean          @default(false)
  meetingPointAddress String?
  meetingPointLat     Float?
  meetingPointLng     Float?
  status              TripStatus       @default(OPEN)
  createdAt           DateTime         @default(now())
  durationSeconds     Int?             // from the Mapbox Directions call at creation; null if routing failed/implausible — auto-completion skips those, manual override still works
  cancelReason        String?          // host's optional reason, shown in the passenger cancellation notification
  cancelledAt         DateTime?
  // The driver's position lives on the day's TripRun (sub-project B). These
  // three are unused since then; they stay only so deploys (plain `db push`)
  // don't need a data-loss change. Drop them with the move to migrations.
  lastKnownLat          Float?
  lastKnownLng          Float?
  lastLocationUpdatedAt DateTime?

  matches             Match[]
  messages            Message[]
  runs                TripRun[]

  @@index([hostId])
  @@index([status])
}

model Match {
  id                String      @id @default(cuid())
  tripId            String
  trip              Trip        @relation(fields: [tripId], references: [id])
  passengerId       String
  passenger         User        @relation("PassengerMatches", fields: [passengerId], references: [id])
  score             Float
  routeOverlap      Float
  scheduleAlignment Float
  preferenceMatch   Boolean
  status            MatchStatus @default(PENDING)
  message           String?     // optional note from the passenger to the host, sent with the join request
  fuelShareAmount   Float?      // snapshot of the trip's fuelSharePerSeat at request time; null if the trip had no computed share
  createdAt         DateTime    @default(now())
  respondedAt       DateTime?
  // Sub-project G: the rider's switch and latest position, shown only to the
  // trip's driver before pickup; erased at Start Trip.
  sharesLocation    Boolean     @default(false)
  riderLat          Float?
  riderLng          Float?
  riderLocatedAt    DateTime?

  ratings           Rating[]
  reports           Report[]

  @@index([tripId])
  @@index([passengerId])
  @@index([status])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  type           NotificationType
  message        String
  relatedMatchId String?          // the specific join request, when the notification is about one
  relatedTripId  String?          // the trip a click on this notification navigates to
  // Which calendar occurrence this notification is about — set for REMINDER
  // and RATING_PROMPT on a recurring trip, where the same trip/match produces
  // one of these per occurrence rather than once ever, and for the trip-day
  // notifications (CONFIRM_REQUEST, DRIVER_*, TRIP_SKIPPED; sub-project D).
  occurrenceDate DateTime?
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  pushedAt       DateTime? // set by the push outbox once handled (sub-project F)

  @@index([userId])
  @@index([createdAt])
}

// One shared thread per trip — the host and every APPROVED passenger, not
// private 1:1 threads (Task: trip group chat). Access is a hard cutoff, not
// an archive: once the trip is COMPLETED/CANCELLED, nobody — host included —
// can read or post to it again (enforced in messageController.js, not here;
// this model has no lifecycle awareness of its own, same as Rating/Match not
// knowing their trip's status).
model Message {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([tripId])
}

model Preference {
  id                   String           @id @default(cuid())
  userId               String           @unique
  user                 User             @relation(fields: [userId], references: [id])
  genderPreference     GenderPreference @default(ANY)
  flexWindowMinutes    Int              @default(15)
  familiarRidersOnly   Boolean          @default(false)
  // Unused since Start Trip shares location (sub-project B); kept so deploys
  // don't need a data-loss change. Drop with the move to migrations.
  liveLocationSharing  Boolean          @default(false)
}

model Rating {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id])
  raterId   String
  rater     User     @relation("RaterRatings", fields: [raterId], references: [id])
  rateeId   String
  ratee     User     @relation("RateeRatings", fields: [rateeId], references: [id])
  score     Int
  comment   String?
  anonymous Boolean  @default(false) // rater chose to hide their name on the ratee's public profile; enforced in GET /api/users/:id/ratings, which then omits every rater-identifying field
  // The calendar occurrence this rating is for. For a ONE_TIME trip there is
  // only ever one value, computed once from the trip's departureTime, so
  // behavior is unchanged. For a recurring trip this is what lets the same
  // standing match accumulate one rating per ride instead of one ever.
  occurrenceDate DateTime
  createdAt DateTime @default(now())

  // One rating per direction per match PER OCCURRENCE: the passenger rates
  // the host once per ride, the host rates the passenger once per ride.
  // Enforced here, not just in the UI — the submitRating controller maps the
  // resulting P2002 to 409 ALREADY_RATED.
  @@unique([matchId, raterId, occurrenceDate])
}

// A user or ride-issue report — deliberately its own model, separate from
// Rating: a harassment report and a 1-star "was late" rating must never mix,
// since only Report feeds the automated ban ladder
// (server/services/reportEnforcementService.js). reportedUserId is set in
// both submission flows (report-a-user sets it directly; report-a-trip/match
// derives it server-side as the other party on that match) but is kept
// nullable per spec for a possible future non-user report. category maps to
// a severity tier in code (HARASSMENT/SAFETY = high-alert) — that mapping is
// a constant; admins can additionally review a report (status/reviewedBy) and
// ban or dismiss through /api/admin/reports.
model Report {
  id              String         @id @default(cuid())
  reporterId      String
  reporter        User           @relation("ReportsFiled", fields: [reporterId], references: [id])
  reportedUserId  String?
  reportedUser    User?          @relation("ReportsReceived", fields: [reportedUserId], references: [id])
  reportedMatchId String?
  reportedMatch   Match?         @relation(fields: [reportedMatchId], references: [id])
  category        ReportCategory
  description     String?        // optional free text, capped at 500 chars (server-enforced, not just UI)
  createdAt       DateTime       @default(now())
  status          ReportStatus   @default(OPEN)
  reviewedById    String?
  reviewedBy      User?          @relation("ReportsReviewed", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  reviewNote      String?

  // Powers the enforcement window query (distinct qualifying reporters against
  // a user within the last 90 days) and the per-reporter abuse-guard count.
  @@index([reportedUserId, createdAt])
  @@index([reporterId, createdAt])
  @@index([status, createdAt])
}

// Official fuel price history. The newest row is the current cap on the
// price a host may enter when posting a trip; no rows means no cap.
model FuelPrice {
  id            String   @id @default(cuid())
  fuelType      FuelType @default(REGULAR) // rows from before per-type prices are Regular
  pricePerLiter Float
  setById       String
  setBy         User     @relation(fields: [setById], references: [id])
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([fuelType, createdAt])
}

// Audit log of every admin action and every automatic ban (actorId null).
// Targets are plain ids, not foreign keys, so the trail survives deletions.
model AdminAction {
  id             String          @id @default(cuid())
  actorId        String?
  actor          User?           @relation("AdminActionActor", fields: [actorId], references: [id])
  action         AdminActionType
  targetUserId   String?
  targetTripId   String?
  targetReportId String?
  details        Json?
  createdAt      DateTime        @default(now())

  @@index([createdAt])
  @@index([targetUserId, createdAt])
}

// Registration 2FA: one row per in-progress signup attempt. Not linked to
// User because the account doesn't exist until the OTP is verified and the
// password/name step completes.
model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model SupportTicket {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation("SupportTickets", fields: [userId], references: [id])
  category      SupportCategory
  subject       String
  relatedTripId String?          // one of the user's own trips, for context
  status        SupportStatus    @default(OPEN)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  closedAt      DateTime?
  messages      SupportMessage[]

  @@index([status, category, updatedAt])
  @@index([userId, status])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation("SupportMessages", fields: [authorId], references: [id])
  fromAdmin Boolean
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// Admin message to every user (dashboard banner + notification).
model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  createdById String
  createdBy   User      @relation("Announcements", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  endsAt      DateTime?

  @@index([createdAt])
}

// Database copy of the security log for admin monitoring. Deliberately no IP
// and no email (the stderr log keeps those); purged after 30 days.
model SecurityEvent {
  id        String   @id @default(cuid())
  event     String
  reason    String?
  userId    String?  // no relation: a failed sign-in may name no real account
  route     String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event, createdAt])
  @@index([userId, createdAt])
}

// Which half of the app a user is looking at (sub-project C). A view
// setting only: nothing on the server depends on it.
enum AppMode {
  PASSENGER
  DRIVER
}

enum RunStatus {
  CONFIRMED // driver confirmed the day ahead of time (sub-project D)
  ONGOING
  COMPLETED
  SKIPPED // driver isn't driving that day (recurring trips)
  NO_SHOW // not started 60 minutes after departure, with approved riders
}

enum RunEndReason {
  DRIVER  // End Trip
  AUTO    // 60 minutes after planned arrival
  ARRIVED // near campus while ongoing
}

// One day's run of a trip, created when the driver taps Start Trip
// (sub-project B). A day nobody started has no row. runDate is the
// departure's Philippine calendar day, as phDateOnly() gives it.
model TripRun {
  id                    String        @id @default(cuid())
  tripId                String
  trip                  Trip          @relation(fields: [tripId], references: [id])
  runDate               DateTime
  status                RunStatus     @default(ONGOING)
  startedAt             DateTime? // set only by Start Trip
  confirmedAt           DateTime?
  skipReason            String?
  plannedArrivalAt      DateTime
  endedAt               DateTime?
  endReason             RunEndReason?
  lastKnownLat          Float?
  lastKnownLng          Float?
  lastLocationUpdatedAt DateTime?
  etaAt                 DateTime?
  createdAt             DateTime      @default(now())

  @@unique([tripId, runDate])
  @@index([status])
}

// Driver's license verification (sub-project E). One row per submission; a
// user's current license is their newest row. The photo is encrypted in
// LICENSE_DIR and, like the full number, erased once an admin decides.
enum LicenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LicenseType {
  NON_PROFESSIONAL
  PROFESSIONAL
  STUDENT_PERMIT
}

enum LicenseRejectReason {
  UNREADABLE
  DETAILS_MISMATCH
  EXPIRED
  STUDENT_PERMIT
  NOT_A_LICENSE
  NAME_MISMATCH
  OTHER
}

model DriverLicense {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id])
  status       LicenseStatus        @default(PENDING)
  licenseType  LicenseType
  numberEnc    String? // full number, encrypted; erased on the decision
  numberLast4  String
  expiresOn    DateTime // a Philippine date, stored at 00:00 UTC
  photoFile    String? // file name under LICENSE_DIR; null once decided
  submittedAt  DateTime             @default(now())
  decidedAt    DateTime?
  decidedById  String? // plain id, like AdminAction's, so it survives account deletion
  rejectReason LicenseRejectReason?
  rejectNote   String?

  @@index([userId, submittedAt])
  @@index([status, submittedAt])
}

// A phone or browser that accepted Web Push (sub-project F). An endpoint
// belongs to the newest account that registered it.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  endpoint   String    @unique
  p256dh     String
  auth       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}
