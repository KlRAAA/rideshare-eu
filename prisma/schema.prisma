generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  FACULTY
  STAFF
}

enum GenderPreference {
  ANY
  SAME_GENDER
}

enum RecurrenceType {
  ONE_TIME
  DAILY
  WEEKDAYS
  CUSTOM
}

enum TripStatus {
  OPEN
  FULL
  CANCELLED
  COMPLETED
}

enum MatchStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
  COMPLETED
}

enum NotificationType {
  MATCH_REQUEST
  APPROVAL
  REMINDER
  RATING_PROMPT
  CANCELLATION
  TRIP_UPDATED
  MESSAGE
}

enum ReportCategory {
  SPAM
  NO_SHOW
  INAPPROPRIATE_BEHAVIOR
  HARASSMENT
  SAFETY
  OTHER
}

model User {
  id           String   @id @default(cuid())
  universityId String   @unique // self-reported (e.g. "2023-12345"); no live ICTD record to verify it against
  email        String   @unique
  passwordHash String   // bcrypt — there is no ICTD/Workspace SSO to hand off to
  // fullName and gender are AES-256-GCM ciphertext at rest (iv:authTag:data,
  // base64 — server/services/encryptionService.js), encrypted/decrypted in
  // application code, never filtered or sorted on at the DB level. gender was
  // a native Postgres enum (MALE/FEMALE/UNSPECIFIED) before this — now a
  // String holding ciphertext of one of those same three plaintext values;
  // UNSPECIFIED is the safe default for the SAME_GENDER hard constraint to
  // fail closed on, unchanged from before.
  fullName     String
  role         Role
  gender       String   // drives the SAME_GENDER hard constraint (Task 10)
  verified     Boolean  @default(false) // true once registration's OTP + domain whitelist checks pass
  avatarUrl    String?  // /uploads/avatars/<uuid>.<ext>, served from Next's public/; null = show initials
  trustScore   Float    @default(5.0)
  tripCount    Int      @default(0)
  createdAt    DateTime @default(now())
  // Terms-of-use / privacy-policy consent, captured at registration
  // (authController.completeRegistration) — both null for any account that
  // predates this column. termsVersion records WHICH version was agreed to,
  // since re-prompting on a future terms change means comparing against a
  // stored version, not just checking "is this non-null".
  termsAcceptedAt DateTime?
  termsVersion    String?
  // Automated moderation state (server/services/reportEnforcementService.js) —
  // set only by the flat strike-ladder in code, never by a human reviewer:
  // there's no admin role in this app, deliberately (see the thesis's IP/
  // compliance notes on authorization). A far-future bannedUntil (year 9999)
  // IS how "permanent" is represented — no separate boolean — so the
  // authenticate middleware's ban check stays one timestamp comparison
  // instead of needing a second branch. banReason stores the ReportCategory
  // that triggered this specific ban action.
  bannedUntil DateTime?
  banReason   String?
  banSeverity String? // "STANDARD" | "HIGH_ALERT"
  // Flips true the first time this user finishes or skips the onboarding
  // tour (PATCH /api/users/me/onboarding) — either one means "don't auto-show
  // again," not just a completed run. "Show tutorial again" replays the tour
  // client-side without touching this column.
  hasSeenOnboarding Boolean @default(false)

  vehicles        Vehicle[]
  hostedTrips     Trip[]          @relation("HostTrips")
  matches         Match[]         @relation("PassengerMatches")
  notifications   Notification[]
  preference      Preference?
  ratingsGiven    Rating[]        @relation("RaterRatings")
  ratingsReceived Rating[]        @relation("RateeRatings")
  messagesSent    Message[]
  reportsFiled    Report[]        @relation("ReportsFiled")
  reportsReceived Report[]        @relation("ReportsReceived")
}

model Vehicle {
  id                String  @id @default(cuid())
  ownerId           String
  owner             User    @relation(fields: [ownerId], references: [id])
  make              String
  model             String
  color             String
  plate             String?
  fuelEfficiencyKmL Float
  trips             Trip[]

  @@index([ownerId])
}

model Trip {
  id                  String           @id @default(cuid())
  hostId              String
  host                User             @relation("HostTrips", fields: [hostId], references: [id])
  vehicleId           String
  vehicle             Vehicle          @relation(fields: [vehicleId], references: [id])
  // originAddress/destinationAddress/meetingPointAddress are AES-256-GCM
  // ciphertext at rest (same scheme as User.fullName/gender) — the
  // human-readable text is what reveals a home/work location by name, unlike
  // the bare lat/lng pair; those stay plaintext since the PSGA does real
  // arithmetic on them (haversine, route-overlap sampling) that ciphertext
  // can't support without decrypting on every single computation.
  originAddress       String
  originLat           Float
  originLng           Float
  destinationAddress  String
  destinationLat      Float
  destinationLng      Float
  routeWaypoints      Json?            // [{lat,lng}, ...] road geometry from the Mapbox Directions call at creation; null if it failed the sanity check
  distanceMeters      Int?             // road distance from the same Directions call; feeds nothing yet but persisted alongside durationSeconds so both survive
  departureTime       DateTime
  recurrenceType      RecurrenceType
  customDays          Int[]            @default([]) // 0=Sun..6=Sat, used when CUSTOM
  totalSeats          Int
  filledSeats         Int              @default(0)
  fuelShareSuggested  Float?           // DEPRECATED — old host-typed guess, no longer read or written; superseded by fuelSharePerSeat. Kept only to avoid a destructive column drop; safe to remove in a later migration.
  fuelPricePerLiter   Float?           // host-entered retail price (PHP/L) at posting time — no reliable free PH fuel-price API exists, so the host supplies today's price instead of a stale hardcoded default. Frozen alongside fuelSharePerSeat once computed.
  fuelSharePerSeat    Float?           // fixed voluntary contribution per passenger seat, computed once at posting from distance / vehicle efficiency / fuelPricePerLiter ÷ totalSeats (driver excluded); null if distance or price was unavailable
  driverNotes         String?
  genderPreference    GenderPreference @default(ANY)
  flexibleDeparture   Boolean          @default(false)
  flexWindowMinutes   Int              @default(15)
  familiarRidersOnly  Boolean          @default(false)
  meetingPointAddress String?
  meetingPointLat     Float?
  meetingPointLng     Float?
  status              TripStatus       @default(OPEN)
  createdAt           DateTime         @default(now())
  durationSeconds     Int?             // from the Mapbox Directions call at creation; null if routing failed/implausible — auto-completion skips those, manual override still works
  cancelReason        String?          // host's optional reason, shown in the passenger cancellation notification
  cancelledAt         DateTime?
  // Host's last-known position while liveLocationSharing is on — one current
  // value, not a trail, so flat columns on Trip match the rest of this
  // model's mutable single-value fields (filledSeats, status) rather than a
  // separate history table nothing here needs. Written by the host's own
  // device, read by the host + this trip's APPROVED passengers only.
  lastKnownLat          Float?
  lastKnownLng          Float?
  lastLocationUpdatedAt DateTime?

  matches             Match[]
  messages            Message[]

  @@index([hostId])
  @@index([status])
}

model Match {
  id                String      @id @default(cuid())
  tripId            String
  trip              Trip        @relation(fields: [tripId], references: [id])
  passengerId       String
  passenger         User        @relation("PassengerMatches", fields: [passengerId], references: [id])
  score             Float
  routeOverlap      Float
  scheduleAlignment Float
  preferenceMatch   Boolean
  status            MatchStatus @default(PENDING)
  message           String?     // optional note from the passenger to the host, sent with the join request
  fuelShareAmount   Float?      // snapshot of the trip's fuelSharePerSeat at request time; null if the trip had no computed share
  createdAt         DateTime    @default(now())
  respondedAt       DateTime?

  ratings           Rating[]
  reports           Report[]

  @@index([tripId])
  @@index([passengerId])
  @@index([status])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  type           NotificationType
  message        String
  relatedMatchId String?          // the specific join request, when the notification is about one
  relatedTripId  String?          // the trip a click on this notification navigates to
  // Which calendar occurrence this notification is about — only set for
  // REMINDER and RATING_PROMPT on a recurring trip, where the same trip/match
  // produces one of these per occurrence rather than once ever. Null for
  // ONE_TIME trips and every other notification type.
  occurrenceDate DateTime?
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([userId])
}

// One shared thread per trip — the host and every APPROVED passenger, not
// private 1:1 threads (Task: trip group chat). Access is a hard cutoff, not
// an archive: once the trip is COMPLETED/CANCELLED, nobody — host included —
// can read or post to it again (enforced in messageController.js, not here;
// this model has no lifecycle awareness of its own, same as Rating/Match not
// knowing their trip's status).
model Message {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([tripId])
}

model Preference {
  id                   String           @id @default(cuid())
  userId               String           @unique
  user                 User             @relation(fields: [userId], references: [id])
  genderPreference     GenderPreference @default(ANY)
  flexWindowMinutes    Int              @default(15)
  familiarRidersOnly   Boolean          @default(false)
  liveLocationSharing  Boolean          @default(false) // gates the optional Geolocation campus-proximity signal
}

model Rating {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id])
  raterId   String
  rater     User     @relation("RaterRatings", fields: [raterId], references: [id])
  rateeId   String
  ratee     User     @relation("RateeRatings", fields: [rateeId], references: [id])
  score     Int
  comment   String?
  anonymous Boolean  @default(false) // rater chose to hide their name on the ratee's public profile; enforced in GET /api/users/:id/ratings, which then omits every rater-identifying field
  // The calendar occurrence this rating is for. For a ONE_TIME trip there is
  // only ever one value, computed once from the trip's departureTime, so
  // behavior is unchanged. For a recurring trip this is what lets the same
  // standing match accumulate one rating per ride instead of one ever.
  occurrenceDate DateTime
  createdAt DateTime @default(now())

  // One rating per direction per match PER OCCURRENCE: the passenger rates
  // the host once per ride, the host rates the passenger once per ride.
  // Enforced here, not just in the UI — the submitRating controller maps the
  // resulting P2002 to 409 ALREADY_RATED.
  @@unique([matchId, raterId, occurrenceDate])
}

// A user or ride-issue report — deliberately its own model, separate from
// Rating: a harassment report and a 1-star "was late" rating must never mix,
// since only Report feeds the automated ban ladder
// (server/services/reportEnforcementService.js). reportedUserId is set in
// both submission flows (report-a-user sets it directly; report-a-trip/match
// derives it server-side as the other party on that match) but is kept
// nullable per spec for a possible future non-user report. category maps to
// a severity tier in code (HARASSMENT/SAFETY = high-alert) — that mapping is
// a constant, never a per-report human judgment call, since no admin role
// reviews these.
model Report {
  id              String         @id @default(cuid())
  reporterId      String
  reporter        User           @relation("ReportsFiled", fields: [reporterId], references: [id])
  reportedUserId  String?
  reportedUser    User?          @relation("ReportsReceived", fields: [reportedUserId], references: [id])
  reportedMatchId String?
  reportedMatch   Match?         @relation(fields: [reportedMatchId], references: [id])
  category        ReportCategory
  description     String?        // optional free text, capped at 500 chars (server-enforced, not just UI)
  createdAt       DateTime       @default(now())

  // Powers the enforcement window query (distinct qualifying reporters against
  // a user within the last 90 days) and the per-reporter abuse-guard count.
  @@index([reportedUserId, createdAt])
  @@index([reporterId, createdAt])
}

// Registration 2FA: one row per in-progress signup attempt. Not linked to
// User because the account doesn't exist until the OTP is verified and the
// password/name step completes.
model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}
