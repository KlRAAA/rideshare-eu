
# Must be the EXACT SAME value as JWT_SECRET in the server's .env (not this
# file) — the Next.js app verifies session tokens itself (src/lib/session.ts)
# using this value, independently of the Express API, which verifies the same
# token against its own .env. If the two ever drift apart, every
# server-rendered /auth/* page silently treats every logged-in user as
# logged-out (getSessionUserId's jwt.verify throws on a secret mismatch and
# the caller just catches it and returns null) while the Express API itself
# keeps working fine — a confusing, silent split-brain, not a loud error.
# Generate once (see .env.example), then copy the identical value into both
# files.
JWT_SECRET="change-me-to-match-the-server-.env-exactly"
# Local only. Leave it out on Vercel: in production the browser calls the
# site's own /api/* and src/proxy.ts forwards to API_ORIGIN (the Railway URL)
# with ORIGIN_SECRET, the same value as on Railway.
NEXT_PUBLIC_API_URL="http://localhost:4000"
# API_ORIGIN="https://your-api.up.railway.app"
# ORIGIN_SECRET=""

# Mapbox GL JS + Directions API (RouteMap component, src/lib/directions.ts).
# A `pk.` publishable token — safe to share within the team, not a secret in
# the traditional sense. Get one at https://account.mapbox.com/access-tokens/.
NEXT_PUBLIC_MAPBOX_TOKEN=""
