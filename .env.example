# Local PostgreSQL 17 service (see README). Create the DB with:
#   createdb -U postgres rideshare_dev
DATABASE_URL="postgres://postgres:postgres@localhost:5432/rideshare_dev"
# Generate a real random value, never reuse this placeholder — e.g.:
#   openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# AES-256-GCM key for field-level PII encryption (User.fullName, User.gender,
# Trip's address fields — see server/services/encryptionService.js). Must be
# exactly 32 bytes hex-encoded (64 hex characters). Generate with:
#   openssl rand -hex 32
# Losing this key makes every already-encrypted row permanently unreadable —
# back it up somewhere safe and separate from this repo, not just in .env.
PII_ENCRYPTION_KEY="change-me-to-a-64-char-hex-string"
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Origin(s) the Express API accepts credentialed CORS requests from — the Next
# dev server. Comma-separated for more than one. Defaults to http://localhost:3000.
CORS_ORIGIN="http://localhost:3000"
# Number of reverse proxies in front of the API. Set to 1 on Railway so the
# auth rate limiter sees each user's real IP instead of the proxy's. Leave
# unset locally — trusting X-Forwarded-For without a proxy lets clients fake it.
# TRUST_PROXY=1
# Maps and routing use Mapbox (map tiles + Directions, called from the browser).
# Create a public token at https://account.mapbox.com/access-tokens/; without it
# the maps show a "Map unavailable" placeholder. Address lookup uses Nominatim
# (OpenStreetMap) through the API's /api/geocode route and needs no key.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Registration OTP email delivery. Leave unset during development - emailService.js
# falls back to logging the OTP to the server console when these are missing
# AND NODE_ENV is not "production". A Google Workspace account's app-password
# works as SMTP_USER/SMTP_PASS here.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="RideShareEU <no-reply@mseuf.edu.ph>"

# Contact address included in an automated ban notification email and shown
# on the in-app suspended screen — where a banned user requests a manual
# review, since no admin role reviews bans before they're applied.
REPORT_APPEAL_EMAIL="appeals@rideshareeu.local"

# Help page: campus security number shown under "In an emergency" (leave empty to hide).
NEXT_PUBLIC_CAMPUS_SECURITY_PHONE=""
# Admin overview: link to error reports (e.g. your Sentry issues URL). Hidden when empty.
ADMIN_ERRORS_URL=""
